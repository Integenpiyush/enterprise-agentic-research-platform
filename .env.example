# Copy to .env for local development. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=enterprise-agentic-research-platform

# Local state paths (cloud deployments should use writable temporary storage).
APP_DATA_DIR=./.local_data
SQLITE_DB_PATH=./.local_data/business.sqlite3
CHROMA_DIR=./.local_data/chroma
CHECKPOINT_DB_PATH=./.local_data/checkpoints.sqlite3
MEMORY_DB_PATH=./.local_data/memory.sqlite3

# Retrieval and workflow controls
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_RESEARCH_REPLANS=1
MAX_SQL_ROWS=100
WEB_SEARCH_PROVIDER=duckduckgo

# Safer LangGraph checkpoint deserialization for persisted state
LANGGRAPH_STRICT_MSGPACK=true
